<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 ships with every Windows 10/11, so the exe runs without installing a runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PhoneShare</AssemblyName>
    <RootNamespace>PhoneShare</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>PhoneShare</Product>
    <Description>PhoneShare — экран и звук телефона на ПК</Description>
    <Copyright>PhoneShare</Copyright>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same web/ the phone serves; the window hands it out from 127.0.0.1. -->
    <EmbeddedResource Include="..\web\*.*" LogicalName="web/%(Filename)%(Extension)" />
    <!-- One-file exe: WebView2 assemblies and the x64 native loader travel inside it (see EmbeddedLib in Program.cs). -->
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll" LogicalName="lib/Microsoft.Web.WebView2.Core.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.WinForms.dll" LogicalName="lib/Microsoft.Web.WebView2.WinForms.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="lib/WebView2Loader.dll" Visible="false" />
  </ItemGroup>
</Project>
