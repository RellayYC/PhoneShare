<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <!-- the same header as the PC page: the icon in the screen's colours and the name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- shown by MainActivity when GitHub has a signed newer APK -->
        <LinearLayout
            android:id="@+id/update"
            style="@style/Card"
            android:animateLayoutChanges="true"
            android:background="@drawable/bg_card_live"
            android:visibility="gone">

            <TextView
                android:id="@+id/update_text"
                style="@style/Hint"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <Button
                android:id="@+id/update_go"
                style="@style/Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/update" />
        </LinearLayout>

        <!-- on air or not, and the one button that changes it; MainActivity tints the card while live -->
        <LinearLayout
            android:id="@+id/status_card"
            style="@style/Card"
            android:animateLayoutChanges="true"
            android:paddingTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/status_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="sans-serif-condensed"
                    android:text="@string/status_off"
                    android:textColor="@color/ink"
                    android:textSize="27sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/status_text"
                style="@style/Hint"
                android:layout_marginTop="6dp"
                android:text="@string/status_off_text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/toggle"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/start" />

            <TextView
                android:id="@+id/error"
                style="@style/Hint"
                android:layout_marginTop="10dp"
                android:textColor="@color/danger"
                android:visibility="gone" />
        </LinearLayout>

        <!-- what the PC needs: the address and the PIN, laid out like the PC's PIN screen -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Label"
                android:text="@string/how_label" />

            <TextView
                android:id="@+id/url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/ink"
                android:textIsSelectable="true"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/how_hint"
                style="@style/Hint"
                android:layout_marginTop="6dp"
                android:text="@string/how_hint" />

            <Button
                android:id="@+id/copy"
                style="@style/Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/copy" />

            <View style="@style/Divider" />

            <TextView
                style="@style/Label"
                android:text="@string/pin_label" />

            <LinearLayout
                android:id="@+id/pin_cells"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/new_pin"
                    style="@style/Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_pin" />

                <TextView
                    style="@style/Hint"
                    android:layout_width="0dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/pin_hint"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- the sliders reach into the card's padding so their tracks line up with the text: no clipping there -->
        <LinearLayout
            style="@style/Card"
            android:clipToPadding="false">

            <TextView
                style="@style/Label"
                android:text="@string/quality_label" />

            <!-- sharpness and smoothness are chosen apart: a sharp slow picture or a rough fast one;
                 MainActivity fills the stops this phone's screen can show -->
            <LinearLayout style="@style/StopsRow">

                <TextView
                    style="@style/StopsName"
                    android:labelFor="@+id/size"
                    android:text="@string/size_label" />

                <TextView
                    android:id="@+id/size_value"
                    style="@style/StopsValue"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/size"
                style="@style/Stops" />

            <LinearLayout
                style="@style/StopsRow"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/StopsName"
                    android:labelFor="@+id/fps"
                    android:text="@string/fps_label" />

                <TextView
                    android:id="@+id/fps_value"
                    style="@style/StopsValue"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/fps"
                style="@style/Stops" />

            <TextView
                android:id="@+id/quality_hint"
                style="@style/Hint"
                android:layout_marginTop="4dp" />

            <View style="@style/Divider" />

            <Switch
                android:id="@+id/audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/audio"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:thumbTint="@color/switch_thumb"
                android:trackTint="@color/switch_track" />

            <!-- where the sound plays; applied to a running stream at once -->
            <RadioGroup
                android:id="@+id/audio_where"
                style="@style/Segments">

                <RadioButton
                    android:id="@+id/audio_both"
                    style="@style/Segment"
                    android:text="@string/audio_both" />

                <RadioButton
                    android:id="@+id/audio_pc"
                    style="@style/Segment"
                    android:text="@string/audio_pc" />
            </RadioGroup>

            <TextView
                android:id="@+id/audio_hint"
                style="@style/Hint"
                android:layout_marginTop="4dp"
                android:text="@string/audio_hint" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Label"
                android:text="@string/viewers_label" />

            <TextView
                android:id="@+id/viewers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:lineSpacingExtra="6dp"
                android:text="@string/viewers_none"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- this version, a check on demand; an update found shows up in the card at the top -->
        <LinearLayout
            style="@style/Card"
            android:animateLayoutChanges="true">

            <TextView
                style="@style/Label"
                android:text="@string/updates_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/version"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/update_check"
                    style="@style/Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_check" />
            </LinearLayout>

            <TextView
                android:id="@+id/update_status"
                style="@style/Hint"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
