<?xml version="1.0" encoding="utf-8"?>
<!-- the chosen segment wears the lamp; 10 + 4 padding = the track's 14 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22808A9A">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item>
        <selector android:enterFadeDuration="150" android:exitFadeDuration="150">
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/lamp_soft"/>
                    <stroke android:width="1.5dp" android:color="@color/lamp"/>
                    <corners android:radius="10dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent"/>
                    <corners android:radius="10dp"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
