<?xml version="1.0" encoding="utf-8"?>
<!-- quality tiles: the chosen one wears the lamp -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22808A9A">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/lamp_soft"/>
                    <stroke android:width="2dp" android:color="@color/lamp"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/raised"/>
                    <stroke android:width="1dp" android:color="@color/line"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
