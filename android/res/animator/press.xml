<?xml version="1.0" encoding="utf-8"?>
<!-- a button gives a little under the finger: 0.96, quick in, a touch slower out -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <set>
            <objectAnimator android:duration="90" android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleX" android:valueTo="0.96" android:valueType="floatType" />
            <objectAnimator android:duration="90" android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleY" android:valueTo="0.96" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="160" android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
